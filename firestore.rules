rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isPM() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pm';
    }
    function isClient() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client';
    }
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }
    match /projects/{projectId} {
      allow read: if isAdmin() || isPM() || (isClient() && resource.data.clientId == request.auth.uid) || resource.data.status in ['in_progress', 'completed'];
      allow write: if isAdmin() || isPM();
    }
    match /projects/{projectId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    match /projectRequests/{requestId} {
      allow create: if request.auth != null && isClient();
      allow read, update: if isAdmin() || resource.data.clientId == request.auth.uid;
    }
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || resource.data.clientId == request.auth.uid;
      allow write: if isAdmin();
    }
    match /designs/{designId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isPM();
    }
    match /photos/{photoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /maintenance/{scheduleId} {
      allow read: if isAdmin() || isPM() || resource.data.clientId == request.auth.uid;
      allow write: if isAdmin() || isPM();
    }
    match /reviews/{reviewId} {
      allow create: if isClient();
      allow read: if isAdmin() || resource.data.clientId == request.auth.uid;
    }
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    match /documents/{docId} {
      allow read: if isAdmin() || resource.data.clientId == request.auth.uid;
      allow write: if isAdmin();
    }
  }
}
